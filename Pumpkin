-- Public client probability table; no forced rare results.
local rng = Random.new()
local function probabilityRows()
    local map = require(lib.Client.EggCmds).GetProbabilityMap(eggId)
    local result, total = {}, 0
    for _, row in ipairs(egg:Directory().pets) do
        local weight = assert(map[row[1]], "Missing public egg probability")
        total += weight
        result[#result+1] = {id=row[1], weight=weight}
    end
    return result, total
end
local function rollPet()
    local options, total = probabilityRows()
    local value, accumulated = rng:NextNumber(0,total), 0
    local selected = options[#options]
    for _, row in ipairs(options) do
        accumulated += row.weight
        if value < accumulated then selected=row;break end
    end
    local pet = PetItem(selected.id)
    local config = egg:Directory()
    -- These are the chances published in the client egg directory.
    if not config.disableGold and pet:CanBeGolden()
        and rng:NextNumber(0,100) < (config.goldChance or 0) then pet:SetGolden() end
    if not config.disableRainbow and pet:CanBeRainbow()
        and rng:NextNumber(0,100) < (config.rainbowChance or 0) then pet:SetRainbow() end
    if pet:CanBeShiny() and rng:NextNumber(0,100) < (config.shinyChance or 0) then pet:SetShiny(true) end
    pet:PopulateUID()
    return pet, selected.weight / total
end
local function variantKey(pet)
    return pet:GetId() .. "/" .. tostring(pet:IsRainbow()) .. "/" .. tostring(pet:IsGolden()) .. "/" .. tostring(pet:IsShiny())
end
local function previewGargCount(pet)
    local key, total = variantKey(pet), 0
    for _, record in ipairs(ledger) do
        if record.variantKey == key then total += 1 end
    end
    return total
end
local function assignGargMetadata(pet, reservations)
    if not pet:Directory().gargantuan then return end
    local exists = Exists.Get(pet)
    local key=variantKey(pet)
    local reserved=reservations and (reservations[key] or 0) or 0
    local nextSerial = (type(exists)=="number" and exists or 0) + previewGargCount(pet) + reserved + 1
    if reservations then reservations[key]=reserved+1 end
    pet:SetSerialData({us=player.UserId, sr=nextSerial})
end
local function applyPreviewExists(pet)
    if not pet:Directory().gargantuan then return end
    local plain = pet:Clone()
    plain:SetSerialData(nil)
    pet.GetExistCount = function()
        local real = Exists.Get(plain)
        return (type(real)=="number" and real or 0) + previewGargCount(plain)
    end
end
-- Eight fixed launch directions; each direction has near-to-far reusable positions.
local function circleLayout(amount, root, occupied, vars, hipHeight)
    local spacing=vars.ExclusiveEggSpacingRadius or 4
    local baseRadius=spacing+(vars.ExclusiveEggRadiusRange and vars.ExclusiveEggRadiusRange.X or 8)
    local ringStep=spacing*2
    local minimumDistance=spacing*2-0.01
    local forward=Vector3.new(root.CFrame.LookVector.X,0,root.CFrame.LookVector.Z)
    forward=forward.Magnitude>0.001 and forward.Unit or Vector3.new(0,0,-1)
    local right=Vector3.new(-forward.Z,0,forward.X)
    local center=Vector3.new(root.Position.X,root.Position.Y-root.Size.Y/2-hipHeight,root.Position.Z)
    local positions, rings = {}, {}
    local blockers=table.clone(occupied)
    for level=0,12 do
        local radius=baseRadius+level*ringStep
        local slots=8
        local order={0}
        for offset=1,slots/2 do
            order[#order+1]=offset
            if offset<slots/2 then order[#order+1]=-offset end
        end
        for _,slotIndex in ipairs(order) do
            local angle=slotIndex*2*math.pi/slots
            local point=center+(forward*math.cos(angle)+right*math.sin(angle))*radius
            local free=true
            for _,old in ipairs(blockers) do
                if (point-old).Magnitude<minimumDistance then free=false;break end
            end
            if free then
                positions[#positions+1]=point
                blockers[#blockers+1]=point
                rings[#rings+1]=level
                if #positions==amount then return positions,rings,center end
            end
        end
    end
    error("Wait for some preview eggs to finish")
end
local function circularPositions(amount, root)
    local occupied={}
    for entry in pairs(occupiedEntries) do
        if not entry.completed then occupied[#occupied+1]=entry.position end
    end
    local humanoid=player.Character:FindFirstChildOfClass("Humanoid")
    if #occupied==0 or not layoutAnchor then
        layoutAnchor={Position=root.Position,CFrame=root.CFrame,Size=root.Size,
            HipHeight=humanoid and humanoid.HipHeight or 2}
    end
    local vars=realRequire(lib.Shared.Variables)
    local result,rings,center=circleLayout(amount,layoutAnchor,occupied,vars,layoutAnchor.HipHeight)
    local minimum,maximum=math.huge,0
    for _,point in ipairs(result) do
        local radius=(point-center).Magnitude
        minimum=math.min(minimum,radius)
        maximum=math.max(maximum,radius)
    end
    status.lastRing={amount=amount,occupiedBefore=#occupied,minRadius=minimum,maxRadius=maximum,
        directions=8,rings=rings,center=center,points=result}
    return result
end

