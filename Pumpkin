local MAIN_SOURCE = [========[
-- Local preview: x100 Mythical Eggs in hotbar slot 1, native Open 1/3/8 dialog.
-- Run directly in an executor, or with Real live_reload label local-mythical-hotbar-preview.
local launchOptions = LocalMythicalLaunchOptions
