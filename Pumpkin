local function sandboxRequire(object)
    if object == lib.Client.Network then
        return {
            Fire = function() status.blockedNetwork += 1 end,
            Invoke = function() error("Network is disabled for this local preview") end,
        }
    elseif object == lib.Client.TradingCmds then
        return {Decline = function() end, GetState = function() return nil end}
    elseif object == lib.Variables then
        return previewVars
    elseif object == lib.Client.CustomPet then
        local api = table.clone(realRequire(object))
        local create = api.CreateModel
        api.CreateModel = function(...)
            local model = create(...)
            local pet=select(1,...)
            local owner=type(pet)=="table" and type(pet.GetUID)=="function" and entryByUid[pet:GetUID()] or nil
            track(model,owner)
            if owner then owner.localModels=(owner.localModels or 0)+1 end
            status.spawnedModels += 1
            return model
        end
        return api
    elseif object == module.PositionFinder then
        local api = table.clone(realRequire(object))
        api.ActiveEggs = {}
        return api
    elseif object == module.GargantuanHatch then
        local api = table.clone(realRequire(object))
        local play = api.play
        api.play = function(...)
            status.gargantuanStarted = true
            local result = table.pack(play(...))
            status.gargantuanFinished = true
            return table.unpack(result, 1, result.n)
        end
        return api
    end
    -- ChatMsg.New and NotificationCmds are native LOCAL display functions.
    return realRequire(object)
end
local function buildRenderer()
    local source = assert(decompile(module), "Cannot read egg renderer")
    local boundary = assert(source:find("local u372 = {}", 1, true), "Renderer export changed")
    source = source:sub(1, boundary - 1)
    local watchdog = assert(source:find("task.spawn(function()", 1, true), "Watchdog changed")
    local afterWatchdog = assert(source:find("local v1 = {}", watchdog, true), "Watchdog boundary changed")
    source = source:sub(1, watchdog - 1) .. source:sub(afterWatchdog)
    source = source:gsub("\nfunction ([%w_]+)%(", "\nlocal function %1(")
    local factory = assert(loadstring("local script, require = ...\n" .. source
        .. "\nreturn {render=performAnimation, entries=u253}", "@local-mythical-hotbar-renderer"))
    return factory(module, sandboxRequire)
