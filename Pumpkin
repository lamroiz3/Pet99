local function startBatch(amount)
    assert(not stopped and amount <= count, "Preview stopped or insufficient fake eggs")
    assert(activeBatches<8,"Wait for some preview eggs to finish")
    local root = assert(player.Character and player.Character.PrimaryPart, "Character not ready")
    local positions = circularPositions(amount, root)
    assert(positions and #positions >= amount, "Not enough open space for eggs")
    renderer = renderer or buildRenderer()
    local wasIdle=activeBatches==0
    activeBatches+=1
    busy = true
    status.activeBatches=activeBatches
    status.phase = "opening"
    status.batches += 1
    status.gargantuanStarted, status.gargantuanFinished = false, false
    local camera = workspace.CurrentCamera
    if wasIdle then cameraBefore = {camera=camera, type=camera.CameraType, subject=camera.CameraSubject, fov=camera.FieldOfView} end
    local baseVars = require(lib.Variables)
    if wasIdle then
        for k,v in pairs(baseVars) do previewVars[k] = v end
        previewVars.OpeningEgg = 0
        previewVars.ExclusiveEggActive = 0
    end
    count -= amount
    updateCard()
    local remaining = amount
    characterBefore = player.Character
    rootBefore, rootAnchoredBefore = root, root.Anchored
    local ownedBefore = {}
    local serialReservations = pendingSerialReservations
    local entries, errors = {}, {}
    local began = os.clock()
    local batchRing=table.clone(status.lastRing)
    for i=1,amount do
        local pet, chance = rollPet()
        local id=pet:GetId()
        ownedBefore[id] = ownedBefore[id] or PetItem(id):CountAny()
        assignGargMetadata(pet, serialReservations)
        local d = pet:Directory()
        local entry
        entry = {player=player, origin=root.Position, position=positions[i], eggItem=EggItem(eggId),
            petItem=pet, petChance=chance,
            priority=d.gargantuan and 4 or (d.titanic and 3 or (d.huge and 2 or 1)), partyIndex=i, partyCount=amount, completed=false,
            onEggPart=function(part)
                local model = part:FindFirstAncestorOfClass("Model")
                track(model or part,entry)
            end}
        entries[i] = entry
        renderer.entries[entry] = true
        occupiedEntries[entry]=true
        entryByUid[pet:GetUID()]=entry
    end
    for i,entry in ipairs(entries) do
        threads[#threads+1] = task.spawn(function()
            local ok, problem = xpcall(function() renderer.render(entry) end, debug.traceback)
            if not ok then errors[#errors+1] = tostring(problem) end
            entry.completed = true
            renderer.entries[entry] = nil
            occupiedEntries[entry]=nil
            entryByUid[entry.petItem:GetUID()]=nil
            remaining -= 1
        end)
    end
    threads[#threads+1] = task.spawn(function()
        while remaining > 0 and not stopped and STATE.alive() do task.wait(0.1) end
        if stopped then return end
        storeBatch(entries)
        local owners={}
        local batchModels=0
        for _,entry in ipairs(entries) do owners[entry]=true;batchModels+=(entry.localModels or 0) end
        cleanupModels(owners)
        lastResult = {amount=amount, seconds=os.clock()-began, errors=errors,
            remaining=count, eggBefore=eggBefore, eggAfter=egg:CountAny(),
            spawnedModels=batchModels, gargantuanFinished=status.gargantuanFinished,
            ring=batchRing, received=(function()local t={};for _,e in ipairs(entries) do t[e.petItem:GetId()]=(t[e.petItem:GetId()] or 0)+1 end;return t end)()}
        lastResult.petCounts = {}
        for id, before in pairs(ownedBefore) do
            lastResult.petCounts[id] = {before=before, after=PetItem(id):CountAny()}
        end
        status.lastResult = lastResult
        activeBatches-=1
        status.activeBatches=activeBatches
        busy=activeBatches>0
        status.phase=busy and "opening" or (#errors==0 and "ready" or "error")
        if not busy then
            cleanupModels()
            camera.CameraType=cameraBefore.type
            camera.CameraSubject=cameraBefore.subject
            camera.FieldOfView=cameraBefore.fov
        end
    end)
end
