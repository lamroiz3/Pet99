local function inventoryStacks(records)
    local stacks, byKey = {}, {}
    for _,record in ipairs(records) do
        local pet=PetItem:From(table.clone(record.data)):SetUID(record.uid)
        local d=pet:Directory()
        local separate=d.huge or d.titanic or d.gargantuan
        local key=separate and ("uid/"..record.uid) or ("stack/"..pet:StackKey())
        local stack=byKey[key]
